{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Pacific/Noumea",
  "schedule": [
    "on tuesday"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 20,
  "separateMultipleMajor": true,
  "rangeStrategy": "bump",
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true
    },
    {
      "matchFileNames": [
        "apps/admin/system-upgrade/system-upgrade-controller.yaml",
        "apps/ai/playwright/deployment.yaml"
      ],
      "enabled": false
    },
    {
      "matchFileNames": ["argocd/apps/gateway-api-crds.yaml"],
      "groupName": "infrastructure critique",
      "groupSlug": "infra-critique",
      "automerge": false
    },
    {
      "matchDatasources": ["helm"],
      "matchPackageNames": [
        "argo-cd",
        "cert-manager",
        "csi-driver-nfs",
        "metallb",
        "traefik",
        "tailscale-operator"
      ],
      "groupName": "infrastructure critique",
      "groupSlug": "infra-critique",
      "automerge": false
    }
  ],
  "argocd": {
    "managerFilePatterns": ["argocd/apps/*.yaml"]
  },
  "kubernetes": {
    "managerFilePatterns": ["**/*.yaml"]
  },
  "helm-values": {
    "managerFilePatterns": ["**/values.yaml"]
  }
}
