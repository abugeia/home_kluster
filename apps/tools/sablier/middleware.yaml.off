# Middleware dynamique pour les outils (30 min)
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: sablier-30m
  namespace: tools
spec:
  plugin:
    sablier:
      sablierUrl: http://sablier-sablier.tools.svc.cluster.local:10000
      # Utilise le Host (ex: pg.valab.top) comme nom de groupe Sablier
      group: 30m-group
      sessionDuration: 30m
      dynamic:
        displayName: '{{.Host}}'
        showDetails: true
        theme: ghost
        refreshFrequency: 2s

# Middleware dynamique pour les médias (1h)
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: sablier-1h
  namespace: tools
spec:
  plugin:
    sablier:
      sablierUrl: http://sablier-sablier.tools.svc.cluster.local:10000
      group: 1h-group
      sessionDuration: 1h
      dynamic:
        displayName: '{{.Host}}'
        showDetails: true
        theme: hacker-terminal
        refreshFrequency: 2s
